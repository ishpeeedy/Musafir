<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>musafir</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Musafir",
        "url": "https://musafir.ishpeeedy.dev",
        "description": "Find and share campgrounds. Interactive maps, real-time weather, and community reviews.",
        "applicationCategory": "TravelApplication",
        "author": {
          "@type": "Person",
          "name": "Anuj Sharma",
          "url": "https://ishpeeedy.dev"
        }
      }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script src="https://cdn.maptiler.com/maptiler-sdk-js/latest/maptiler-sdk.umd.min.js"></script>
    <link
      href="https://cdn.maptiler.com/maptiler-sdk-js/latest/maptiler-sdk.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/images/favicon.png" />

    <!-- Bootstrap first so app.css can win on equal specificity without
         needing !important. No integrity hash: add one from getbootstrap.com
         if you want SRI, but a wrong hash blocks the file silently. -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <!-- Custom Theme -->
    <link rel="stylesheet" href="/stylesheets/app.css" />
  </head>

  <body>
    <%- include('../partials/navbar')%>
    <main class="page-main">
      <%- include('../partials/flash')%> <%- body %>
    </main>
    <%- include('../partials/footer')%>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
    <script src="/javascripts/navbar.js"></script>
    <script src="/javascripts/ui.js"></script>
    <script src="/javascripts/validateForms.js"></script>
  </body>
</html>
