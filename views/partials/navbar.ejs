<%
  /*
    No mobile menu, deliberately. The nav is small enough not to need one, and
    dropping it removed the hamburger (whose stroke="var(--ink)" never resolved,
    so it was drawing nothing), the .navbar-collapse mechanism, half of ui.js
    and one of the two Bootstrap compatibility rules. Below 30rem the wordmark
    hides and the mark carries the brand on its own.

    Browsing needs no account, so nothing here asks for one. Register lives on
    the sign-in page; contributor actions live in the account menu.

    WORDMARK: swap this one string to compare the two settings.
  */
  const WORDMARK = "CAIRN";
%>
<nav class="navbar" data-autohide>
  <div class="navbar-inner">

    <a class="navbar-brand" href="/" aria-label="<%= WORDMARK %>, home">
      <%- include('mark') %>
      <span class="navbar-wordmark"><%= WORDMARK %></span>
    </a>

    <div class="navbar-nav">
      <a class="nav-link" href="/campgrounds">Explore</a>

      <% if (!currentUser) { %>
        <a class="nav-link" href="/login">Sign in</a>
      <% } else { %>
        <%
          /* Native <details> rather than a scripted dropdown: same pattern as
             the filter folds, no JavaScript, and with none it degrades to an
             open list instead of an unreachable menu. */
        %>
        <details class="navbar-account">
          <summary class="navbar-account__summary" aria-label="Account">
            <span class="navbar-user__avatar"><%= currentUser.username.charAt(0).toUpperCase() %></span>
          </summary>
          <div class="navbar-account__menu">
            <span class="navbar-account__who">@<%= currentUser.username %></span>
            <a class="navbar-account__item" href="/campgrounds/new">Add campground</a>
            <form action="/logout" method="POST" class="navbar-logout">
              <button type="submit" class="navbar-account__item navbar-account__item--danger">Log out</button>
            </form>
          </div>
        </details>
      <% } %>
    </div>

  </div>
</nav>
