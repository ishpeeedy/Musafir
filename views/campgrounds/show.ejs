<% layout('layouts/boilerplate') %>

<%
// The GIFs are matted into the paper by .wx rather than replaced: they sit
// on a white card, and multiply blending renders white as whatever is behind
// it, so there is no edge left to hide.
function getWeatherIcon(condition) {
  const c = condition.toLowerCase();
  if (c.includes('sun') || c.includes('clear')) return '/images/weather/sunny.gif';
  if (c.includes('partly cloudy') || c.includes('partial')) return '/images/weather/partly-cloudy.gif';
  if (c.includes('cloudy') || c.includes('overcast')) return '/images/weather/cloudy.gif';
  if (c.includes('thunder') || c.includes('storm')) return '/images/weather/thunderstorm.gif';
  if (c.includes('heavy rain') || c.includes('torrential')) return '/images/weather/heavy-rain.gif';
  if (c.includes('rain') || c.includes('drizzle') || c.includes('shower')) return '/images/weather/rain.gif';
  if (c.includes('snow') || c.includes('blizzard')) return '/images/weather/snow.gif';
  if (c.includes('sleet') || c.includes('ice')) return '/images/weather/sleet.gif';
  if (c.includes('fog') || c.includes('mist') || c.includes('haze')) return '/images/weather/foggy.gif';
  if (c.includes('wind')) return '/images/weather/windy.gif';
  return '/images/weather/cloudy.gif';
}
%>

<!-- Drawn marks. Every pictogram on this page comes from here; there are no
     emoji and no icon fonts. Stroked, not filled, to read as engraving. -->
<svg class="svg-sprite" width="0" height="0" aria-hidden="true" focusable="false">
  <symbol id="mark-north" viewBox="0 0 24 34" fill="none" stroke="currentColor">
    <text x="12" y="9" text-anchor="middle" font-family="'IM Fell English SC', serif" font-size="10" fill="currentColor" stroke="none">N</text>
    <path d="M12 12v14.5L8 31Z" stroke-width="1" />
    <path d="M12 12v14.5L16 31Z" fill="currentColor" stroke-width="1" />
  </symbol>

  <symbol id="mark-star" viewBox="0 0 24 24">
    <path fill="currentColor" d="M12 2.6 14.9 9.3 22.1 10 16.7 14.8 18.3 21.9 12 18.2 5.7 21.9 7.3 14.8 1.9 10 9.1 9.3Z" />
  </symbol>

  <symbol id="mark-drop" viewBox="0 0 12 12">
    <path fill="currentColor" d="M6 1.2c0 0 4.3 4.9 4.3 7.1a4.3 4.3 0 0 1-8.6 0C1.7 6.1 6 1.2 6 1.2Z" />
  </symbol>
</svg>

<div class="detail-page">
  <div class="folio">

    <!-- Running head. A plate in a bound folio, not a web page. -->
    <div class="runhead">
      <span><%= campground.region || campground.location %></span>
    </div>

    <!-- ================================================== the photo plate -->
    <% if (campground.images.length >= 1) { %>
    <div class="detail-gallery">
      <div class="gallery-frame gallery-main">
        <img src="<%= campground.images[0].url %>" alt="<%= campground.title %>" />
      </div>
      <div class="gallery-stack">
        <% if (campground.images.length >= 2) { %>
          <div class="gallery-frame"><img src="<%= campground.images[1].url %>" alt="" /></div>
        <% } %>
        <% if (campground.images.length >= 3) { %>
          <div class="gallery-frame">
            <img src="<%= campground.images[2].url %>" alt="" />
            <% if (campground.images.length > 3) { %>
              <span class="gallery-more-overlay"><%= campground.images.length - 3 %> more</span>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- ============================================================ hero -->
    <div class="detail-hero">

      <!-- LEFT, brown plate: the land -->
      <div>
        <h1 class="camp-title"><%= campground.title %></h1>
        <p class="camp-location"><%= campground.location %></p>

        <div class="price-badge">
          <span class="price-label">Per night</span>
          <span class="price-value">₹<%= campground.price %></span>
        </div>

        <!-- The plate break inside this row is deliberate: elevation belongs to
             the land, the other three to the sky. -->
        <div class="stat-grid">
          <div class="stat-card">
            <span class="stat-label">Elevation</span>
            <span class="stat-value"><%= campground.elevation ? campground.elevation.toFixed(0) + ' m' : '—' %></span>
          </div>
          <div class="stat-card stat-card--sky">
            <span class="stat-label">Daylight</span>
            <span class="stat-value"><%= sunData ? sunData.daylight : '—' %></span>
          </div>
          <div class="stat-card stat-card--sky">
            <span class="stat-label">Sunrise</span>
            <span class="stat-value"><%= sunData ? sunData.sunrise : '—' %></span>
          </div>
          <div class="stat-card stat-card--sky">
            <span class="stat-label">Sunset</span>
            <span class="stat-value"><%= sunData ? sunData.sunset : '—' %></span>
          </div>
        </div>

        <p class="prose"><%= campground.description %></p>

        <% if (campground.amenities && campground.amenities.length > 0) { %>
          <div class="chip-row">
            <% campground.amenities.forEach(a => { %><span class="chip"><%= a %></span><% }) %>
          </div>
        <% } %>
        <% if (campground.tags && campground.tags.length > 0) { %>
          <div class="chip-row">
            <% campground.tags.forEach(t => { %><span class="chip chip--tag"><%= t %></span><% }) %>
          </div>
        <% } %>

        <p class="byline">Recorded by <a href="#">@<%= campground.author.username %></a></p>

        <% if (currentUser && campground.author.equals(currentUser._id)) { %>
          <div class="owner-controls">
            <a class="btn-musafir btn-musafir--ghost" href="/campgrounds/<%= campground._id %>/edit">Edit</a>
            <form action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST">
              <button class="btn-musafir btn-musafir--danger">Delete</button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- RIGHT, purple plate: the sky -->
      <div class="detail-sky">
        <p class="section-label section-label--ruled section-label--sky">Conditions</p>

        <% if (weather) { %>
          <div class="conditions-current">
            <div>
              <span class="current-temp"><%= weather.current.temp_c %>°</span>
              <span class="current-feels">feels like <%= Math.round(weather.current.feelslike_c) %>°C</span>
            </div>
            <img class="wx wx--lg" src="<%= getWeatherIcon(weather.current.condition) %>" alt="<%= weather.current.condition %>" />
          </div>

          <div class="readings">
            <span>RH <b><%= weather.current.humidity %>%</b></span>
            <span>Wind <b><%= weather.current.wind_kph %></b> km/h</span>
            <span>Precip <b><%= weather.current.precip_mm %></b> mm</span>
          </div>

          <p class="sub-label">Three day forecast</p>
          <div class="forecast-grid">
            <% weather.forecast.forEach((day, i) => { %>
              <div class="forecast-col <%= i === 0 ? 'forecast-col--today' : '' %>">
                <span class="forecast-day">
                  <%= i === 0 ? 'Today' : new Date(day.date).toLocaleDateString('en-US', { weekday: 'short' }) %>
                </span>
                <center><img class="wx wx--m" src="<%= getWeatherIcon(day.condition) %>" alt="<%= day.condition %>" /></center>
                <span class="forecast-temps"><%= Math.round(day.maxtemp_c) %>°<span>/<%= Math.round(day.mintemp_c) %>°</span></span>
                <span class="forecast-meta"><%= day.daily_chance_of_rain %>% rain</span>
              </div>
            <% }) %>
          </div>

          <p class="sub-label">Last seven days</p>
          <div class="history-table">
            <% weather.history.forEach(day => { %>
              <div class="history-row">
                <% if (parseFloat(day.totalprecip_mm) > 0) { %>
                  <svg class="rain-dot"><use href="#mark-drop"></use></svg>
                <% } else { %><span></span><% } %>
                <span class="history-date">
                  <%= new Date(day.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                </span>
                <img class="wx wx--m" src="<%= getWeatherIcon(day.condition) %>" alt="<%= day.condition %>" />
                <span class="history-temps"><%= Math.round(day.maxtemp_c) %>°/<%= Math.round(day.mintemp_c) %>°</span>
                <span class="history-precip"><%= day.totalprecip_mm %>mm</span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="note note--sky">No readings available for this position.</p>
        <% } %>
      </div>
    </div>

    <!-- ================================================ the land, a pair -->
    <div class="terrain-section">
      <p class="section-label section-label--ruled">Location &amp; terrain</p>

      <% if (campground.terrain && campground.terrain.summary) { %>
        <p class="prose"><%= campground.terrain.summary %>.</p>
      <% } %>

      <!-- Two plates of the same country at two scales, matched and square. -->
      <div class="plate-pair">
        <div class="plate"><div id="map"></div></div>

        <div
          class="plate"
          id="topo-container"
          data-elevation-grid="<%= JSON.stringify(campground.elevationGrid ? campground.elevationGrid.data : []) %>"
          data-box-km="<%= (campground.elevationGrid && campground.elevationGrid.radiusKm ? campground.elevationGrid.radiusKm : 5) * 2 %>"
          <% if (campground.terrain && campground.terrain.aspectBearing != null) { %>
            data-aspect-bearing="<%= campground.terrain.aspectBearing %>"
            data-aspect-name="<%= campground.terrain.aspectName %>"
          <% } %>
        >
          <div class="topo-card__body"></div>
          <svg class="north-arrow"><use href="#mark-north"></use></svg>
          <span class="scale-bar">
            <span class="scale-bar__rule"></span>
            <%= (campground.elevationGrid && campground.elevationGrid.radiusKm ? campground.elevationGrid.radiusKm : 5) * 2 %> km
          </span>
        </div>
      </div>

      <!-- The frame crops MapTiler's own logo and attribution, so credit is
           carried here instead, in the page's own lettering. -->
      <div class="plate-caption">
        <span>
          Base sheet &copy; <a href="https://www.maptiler.com/copyright/" target="_blank" rel="noopener noreferrer">MapTiler</a>,
          &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors.
          Contours from SRTM 30 m.
        </span>
        <span>Station <%= campground.geometry.coordinates[1].toFixed(4) %>, <%= campground.geometry.coordinates[0].toFixed(4) %></span>
      </div>

      <!-- topoMap.js injects the cross-section here -->
      <div id="topo-profile"></div>

      <% if (campground.terrain && campground.terrain.summary) { %>
        <% const t = campground.terrain; %>
        <div class="terrain-metrics">
          <div class="stat-card">
            <span class="stat-label">Relief</span>
            <span class="stat-value"><%= t.relief %> m</span>
            <span class="stat-note"><%= t.minElevation %>–<%= t.maxElevation %>m across 10km</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Position</span>
            <span class="stat-value"><%= t.positionLabel %></span>
            <span class="stat-note"><%= t.percentile %>th percentile locally</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Slope</span>
            <span class="stat-value"><%= t.slopeLabel %></span>
            <span class="stat-note"><%= t.slopeDegrees %>° underfoot</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Aspect</span>
            <span class="stat-value"><%= t.aspectCompass || '—' %></span>
            <span class="stat-note">
              <%= t.aspectBearing !== null && t.aspectBearing !== undefined ? t.aspectBearing + '° · faces ' + t.aspectName : 'no meaningful fall line' %>
            </span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Ground</span>
            <span class="stat-value"><%= t.ruggednessLabel %></span>
            <span class="stat-note">TRI <%= t.ruggedness %></span>
          </div>
        </div>
      <% } %>

      <div class="chip-row chip-row--terrain">
        <% if (campground.tags && campground.tags.includes('Near Trail')) { %>
          <span class="chip">Trail access nearby</span>
        <% } %>
        <% if (campground.tags && campground.tags.includes('Forest')) { %>
          <span class="chip">Dense forest terrain</span>
        <% } %>
        <% if (campground.tags && campground.tags.includes('Mountain')) { %>
          <span class="chip">Mountain terrain</span>
        <% } %>
        <% if (campground.region) { %>
          <span class="chip"><%= campground.region %></span>
        <% } %>
      </div>
    </div>

    <!-- ============================================ when to go, sky plate -->
    <% if (seasonality) { %>
    <%
      // Two variables in one mark: bar height is the monthly mean, bar texture
      // is the state.
      const means = seasonality.months.map(m => (m.tMax + m.tMin) / 2);
      const lo = Math.min.apply(null, means);
      const hi = Math.max.apply(null, means);
      const barHeight = (m) => Math.round(20 + (((m.tMax + m.tMin) / 2 - lo) / ((hi - lo) || 1)) * 80);
    %>
    <div class="season-section">
      <p class="section-label section-label--ruled section-label--sky">When to go</p>
      <p class="note note--sky season-source">
        ERA5 · <%= seasonality.years %>-year normals<%
          if (seasonality.elevationCorrectionC) { %>, adjusted <%=
          seasonality.elevationCorrectionC > 0 ? '-' : '+' %><%=
          Math.abs(seasonality.elevationCorrectionC) %>°C from the <%=
          seasonality.modelElevation %>m model cell<% } %>
      </p>

      <p class="season-verdict"><%= seasonality.summary %></p>

      <div class="season-grid">
        <% seasonality.months.forEach(m => { %>
          <div class="season-month season-month--<%= m.state %>" title="<%= m.name %>: <%= m.label %>">
            <span class="season-month__name"><%= m.name.slice(0, 3) %></span>
            <span class="season-month__track">
              <span class="season-month__bar" style="height:<%= barHeight(m) %>%"></span>
            </span>
            <span class="season-month__state"><%= m.label %></span>
            <span class="season-month__temp"><%= Math.round(m.tMax) %>°/<%= Math.round(m.tMin) %>°</span>
            <span class="season-month__precip"><%= m.snow >= 1 ? m.snow + 'cm' : m.precip + 'mm' %></span>
          </div>
        <% }) %>
      </div>

      <div class="season-key">
        <span class="season-key__item"><i class="season-swatch season-swatch--prime"></i>Prime</span>
        <span class="season-key__item"><i class="season-swatch season-swatch--wet"></i>Monsoon</span>
        <span class="season-key__item"><i class="season-swatch season-swatch--snowbound"></i>Snowbound</span>
        <span class="season-key__item"><i class="season-swatch season-swatch--hot"></i>Too hot</span>
        <span class="season-key__item"><i class="season-swatch season-swatch--cold"></i>Cold</span>
        <span class="season-key__item season-key__note">Bar height, monthly mean</span>
      </div>
    </div>
    <% } %>

    <!-- ======================================================= community -->
    <div class="community-section">
      <p class="section-label section-label--ruled">
        Field notes
        <% if (campground.reviews.length > 0) { %>
          <span class="review-count">
            &nbsp;<%= campground.reviews.length %>
          </span>
        <% } %>
      </p>

      <% if (campground.reviews.length > 0) { %>
      <div class="reviews-grid">
        <% for (let review of campground.reviews) { %>
        <div class="review-card">
          <span class="rating-stars" aria-label="Rated <%= review.rating %> of 5">
            <% for (let s = 1; s <= 5; s++) { %>
              <svg class="<%= s <= review.rating ? '' : 'rating-star--off' %>"><use href="#mark-star"></use></svg>
            <% } %>
          </span>
          <p class="review-body">“<%= review.body %>”</p>
          <div class="review-card__bottom">
            <span class="reviewer-avatar"><%= review.author.username.charAt(0).toUpperCase() %></span>
            <span class="reviewer-name">@<%= review.author.username %></span>
            <% if (currentUser && review.author.equals(currentUser._id)) { %>
              <form
                action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="POST"
              >
                <button class="btn-musafir btn-musafir--danger btn-musafir--sm">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
      <% } else { %>
        <p class="no-reviews">No field notes recorded at this station yet.</p>
      <% } %>

      <% if (currentUser) { %>
      <div class="field-note-form">
        <p class="section-label section-label--ruled">Leave a field note</p>
        <form action="/campgrounds/<%= campground._id %>/reviews" method="POST" class="validated-form" novalidate>
          <div class="form-group">
            <label>Rating</label>
            <fieldset class="rating-input">
              <input type="radio" id="no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible"></label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good"></label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average"></label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good"></label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing"></label>
            </fieldset>
          </div>
          <div class="form-group">
            <label for="body">Your observations</label>
            <textarea
              class="textarea-musafir"
              name="review[body]"
              id="body"
              rows="5"
              placeholder="Terrain, conditions underfoot, water, wildlife…"
              required
            ></textarea>
          </div>
          <button class="btn-musafir">Record note</button>
        </form>
      </div>
      <% } %>
    </div>

  </div><!-- /folio -->
</div><!-- /detail-page -->

<script>
  const maptilerApiKey = '<%- process.env.MAPTILER_API_KEY %>';
  const campground = <%- JSON.stringify(campground) %>;
</script>
<script src="/javascripts/showPageMap.js"></script>
<!-- d3-array first: d3-geo and d3-contour both resolve it off the global d3 -->
<script src="https://cdn.jsdelivr.net/npm/d3-array@3"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-geo@3"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-contour@4"></script>
<script src="/javascripts/topoMap.js"></script>
<script src="/javascripts/validateForms.js"></script>